# What PortableKit's release scripts need to know about this port
# (portablekit/scripts/release_macos.sh; see docs/RELEASING.md).
RELEASE_NAME=Purun
RELEASE_SLUG=purun
RELEASE_TARGET=PurunNative
RELEASE_APP_ID=io.github.teamgdb.Purun
RELEASE_SUMMARY="Play LocoRoco 2 natively from your own disc image"
RELEASE_URL=https://github.com/TeamGDB/Purun
# The game loads no code overlays.
RELEASE_OVERLAYS=0
# Names that are this game's data and must never be packed (lower case).
RELEASE_GAME_NAMES="uces01059*"
